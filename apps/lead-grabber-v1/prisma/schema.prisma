/// ClearSky Scheduled Intents (specs/clearsky-scheduled-intents.md): a place to
/// write down "come back to this on this date". The table knows *when*, not
/// *whether* — each intent type runs its own verification when the row comes
/// due, and only verified intents are handed to the Orchestrator.
model ScheduledIntent {
  id             String                @id @default(cuid())
  /// Which trades business — needed for their settings and their timezone.
  clientId       String
  /// Which customer (PipelineCustomerProfile.id / Contact.id).
  profileId      String
  intentType     ScheduledIntentType
  /// When to look at it.
  dueAt          DateTime
  /// After this, don't bother — set by whatever wrote the row.
  expiresAt      DateTime?
  /// The details: exact quoted words, target date, channel, conversation id, topic.
  payload        Json?
  status         ScheduledIntentStatus @default(PENDING)
  /// Stops a double-run sending twice.
  idempotencyKey String                @unique
  /// Who is supposed to act — Scenario A (customer calls) vs B (they asked us to).
  actor          ScheduledIntentActor
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([clientId])
  @@index([profileId])
  @@index([dueAt])
  @@index([status, dueAt])
  @@map("scheduled_intents")
}

enum ScheduledIntentType {
  SERVICE_RECALL
  KEEP_IN_TOUCH
  REVIEW_REQUEST
  REP_INSTRUCTION
  CUSTOMER_COMMITMENT_A
  CUSTOMER_COMMITMENT_B
}

enum ScheduledIntentStatus {
  PENDING
  DONE
  SKIPPED
  CANCELLED
  EXPIRED
}

enum ScheduledIntentActor {
  CUSTOMER
  BUSINESS
}

/// Telnyx Number Lookup results, cached by number.
///
/// The line type gates the identity tier of every inbound call (§4.3a), so it has to be resolved
/// before a tier is assigned. Caching it here means a repeat caller costs one lookup rather than
/// one per call, and the cache is shared across profiles instead of living on one of them.
///
/// Only successful classifications are stored — a timed-out or failed lookup is never written, so
/// a Telnyx blip can't pin a mobile caller to Tier 2 permanently. Numbers do get ported, so rows
/// are re-checked once past NUMBER_LOOKUP_TTL_DAYS.
model NumberLookup {
  phoneNumber String   @id
  lineType    String
  carrier     String?
  raw         Json?
  lookedUpAt  DateTime @default(now())

  @@map("number_lookups")
}

/// Viewroom integration: one row per view room. Mirrors the shape of viewroom's `rooms` table so
/// the ported UI components can consume it without structural changes. `representative` /
/// `hostContent` / `representativeContent` hold the ids of `CompanyMember` / `ContentLibraryItem`
/// rows (cuid strings), matching how viewroom stored array-of-id columns. `contentActiveState`
/// is a JSON map of `{ host_content_active: { <contentId>: bool }, representative_content_active: { ... } }`.
model ViewRoom {
  id                       String    @id @default(cuid())
  roomId                   String    @unique
  ownerCompanyId           String
  title                    String
  isActive                 Boolean   @default(true)
  representative           String[]  @default([])
  hostContent              String[]  @default([])
  representativeContent    String[]  @default([])
  scheduled                Boolean   @default(false)
  scheduleTime             DateTime?
  customerName             String?
  customerEmail            String?
  customerPhone            String?
  additionalInformation    String?
  representativeId         String?
  contentActiveState       Json?
  created                  DateTime  @default(now())
  updated                  DateTime  @updatedAt
  ownerCompany             Company   @relation(fields: [ownerCompanyId], references: [id], onDelete: Cascade)

  @@index([ownerCompanyId])
  @@map("view_rooms")
}

/// Viewroom integration: one row per uploaded content item (video / pdf / document / image).
/// `file` and `thumbnail` store full Bunny CDN URLs (a2p has no PocketBase file storage, unlike
/// viewroom). `libraryType` is `['host']`, `['representative']`, or both.
model ContentLibraryItem {
  id             String   @id @default(cuid())
  title          String
  description    String?
  type           String
  file           String
  thumbnail      String?
  ownerCompanyId String
  sharedWith     String[] @default([])
  libraryType    String[] @default([])
  active         Boolean  @default(true)
  created        DateTime @default(now())
  updated        DateTime @updatedAt
  ownerCompany   Company  @relation(fields: [ownerCompanyId], references: [id], onDelete: Cascade)

  @@index([ownerCompanyId])
  @@map("content_library")
}

/// Viewroom integration: quote request submitted from a room (Quote panel).
model ViewroomQuote {
  id          String   @id @default(cuid())
  firstName   String?
