generator client {
  provider = "prisma-client-js"
  output   = "../clearsky-db-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                           @id @default(cuid())
  email                     String                           @unique
  password                  String
  tokenKey                  String                           @unique @default(cuid())
  emailVisibility           Boolean                          @default(false)
  verified                  Boolean                          @default(false)
  name                      String?
  avatar                    String?
  role                      UserRole?
  companyId                 String?
  created                   DateTime                         @default(now())
  updated                   DateTime                         @updatedAt
  platformRole              PlatformRole                     @default(TENANT_USER)
  assignedCommunicationLogs CommunicationLogAssignedMember[]
  communicationLogs         CommunicationLog[]
  ownedCompanies            Company[]                        @relation("CompanyOwner")
  teamMemberships           CompanyMember[]
  sentInvites               Invite[]                         @relation("InvitedBy")
  receivedInvites           Invite[]                         @relation("InvitedUser")
  ownedLeadboxes            Leadbox[]
  ownedLeadforms            Leadform[]
  assignedMessages          Message[]
  personalShortcuts         Shortcut[]
  assignedTasks             Task[]                           @relation("UserTasks")
  devices                   UserDevice[]
  company                   Company?                         @relation(fields: [companyId], references: [id])

  @@index([email])
  @@index([tokenKey])
  @@map("users")
}

model SuperUser {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  tokenKey        String   @unique @default(cuid())
  emailVisibility Boolean  @default(false)
  verified        Boolean  @default(false)
  created         DateTime @default(now())
  updated         DateTime @updatedAt

  @@index([email])
  @@index([tokenKey])
  @@map("_superusers")
}

model AuthOrigin {
  id            String   @id @default(cuid())
  collectionRef String
  recordRef     String
  fingerprint   String
  created       DateTime @default(now())
  updated       DateTime @updatedAt

  @@unique([collectionRef, recordRef, fingerprint])
  @@map("_authOrigins")
}

model ExternalAuth {
  id            String   @id @default(cuid())
  collectionRef String
  recordRef     String
  provider      String
  providerId    String
  created       DateTime @default(now())
  updated       DateTime @updatedAt

  @@unique([collectionRef, recordRef, provider])
  @@unique([collectionRef, provider, providerId])
  @@map("_externalAuths")
}

model Mfa {
  id            String   @id @default(cuid())
  collectionRef String
  recordRef     String
  method        String
  created       DateTime @default(now())
  updated       DateTime @updatedAt

  @@index([collectionRef, recordRef])
  @@map("_mfas")
}

model Otp {
  id            String   @id @default(cuid())
  collectionRef String
  recordRef     String
  password      String
  sentTo        String?
  created       DateTime @default(now())
  updated       DateTime @updatedAt
  signupPayload Json?

  @@index([collectionRef, recordRef])
  @@map("_otps")
}

model Company {
  id                          String                       @id @default(cuid())
  name                        String?
  website                     String?
  ownerId                     String
  settings                    Json?
  logo                        String?
  created                     DateTime                     @default(now())
  updated                     DateTime                     @updatedAt
  emailSlug                   String?                      @unique
  callFlows                   CallFlow[]
  callTrackingCategories      CallTrackingCategory[]
  commContainers              CommContainer[]
  communicationLogs           CommunicationLog[]
  communicationThreads        CommunicationThread[]
  owner                       User                         @relation("CompanyOwner", fields: [ownerId], references: [id])
  teamMembers                 CompanyMember[]
  phoneNumbers                CompanyPhoneNumber[]
  contacts                    Contact[]
  dropCalls                   DropCall[]
  googleCalendar              GoogleCalendarConnection?
  invites                     Invite[]
  locations                   Location[]
  messages                    Message[]
  notifications               Notification[]
  pipelineBusinessConfig      PipelineBusinessConfig?
  pipelineCustomerProfiles    PipelineCustomerProfile[]
  commIdentifiers             CommIdentifier[]
  pipelineEvents              PipelineEvent[]
  pipelineOrchestratorProfile PipelineOrchestratorProfile?
  profileMergeCandidates      ProfileMergeCandidate[]
  scheduleEvents              ScheduleEvent[]
  shortcuts                   Shortcut[]
  tasks                       Task[]
  users                       User[]
  viewRooms                   ViewRoom[]
  contentLibraryItems         ContentLibraryItem[]
  viewroomQuotes              ViewroomQuote[]

  @@map("companies")
}

model GoogleCalendarConnection {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  email              String?
  accessToken        String?
  refreshToken       String?
  expiresAt          DateTime?
  calendarId         String    @default("primary")
  created            DateTime  @default(now())
  updated            DateTime  @updatedAt
  representativeId   String?
  lastEmailHistoryId String?
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

/// Cross-instance claim on a Gmail message id. Every deployment sharing this
/// database polls the same mailbox, so the in-process sync mutex cannot stop two
/// hosts from logging the same inbound email twice. A message is processed only
/// by the instance that wins the insert here; a claim older than the takeover
/// window is assumed to belong to a crashed run and can be re-claimed.
model EmailSyncClaim {
  id        String   @id @default(cuid())
  companyId String
  messageId String
  claimedAt DateTime @default(now())

  @@unique([companyId, messageId])
  @@map("email_sync_claims")
}

model SlotHold {
  id               String    @id @default(cuid())
  companyId        String
  representativeId String?
  startTime        DateTime
  endTime          DateTime?
  heldBy           String?
  expiresAt        DateTime
  created          DateTime  @default(now())

  @@index([companyId, startTime])
  @@map("slot_holds")
}

model CallTrackingCategory {
  id                  String               @id @default(cuid())
  companyId           String
  name                String
  sortOrder           Int                  @default(0)
  created             DateTime             @default(now())
  updated             DateTime             @updatedAt
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  communicationLogs   CommunicationLog[]
  companyPhoneNumbers CompanyPhoneNumber[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("call_tracking_categories")
}

model CompanyPhoneNumber {
  id                     String                @id @default(cuid())
  companyId              String
  phoneNumber            String                @unique
  telnyxPhoneNumberId    String?
  created                DateTime              @default(now())
  updated                DateTime              @updatedAt
  callFlowId             String?
  callTrackingCategoryId String?
  connectionLabel        String?
  callFlow               CallFlow?             @relation(fields: [callFlowId], references: [id])
  callTrackingCategory   CallTrackingCategory? @relation(fields: [callTrackingCategoryId], references: [id])
  company                Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([callFlowId])
  @@index([callTrackingCategoryId])
  @@map("company_phone_numbers")
}

model CallFlow {
  id                     String               @id @default(cuid())
  companyId              String
  title                  String
  greetingAudioUrl       String?
  queueHoldAudioUrl      String?
  allUnavailableAudioUrl String?
  backupCellAudioUrl     String?
  failoverConfig         Json?
  created                DateTime             @default(now())
  updated                DateTime             @updatedAt
  rules                  CallFlowRule[]
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyPhoneNumbers    CompanyPhoneNumber[]

  @@index([companyId])
  @@map("call_flows")
}

model CallFlowRule {
  id                   String   @id @default(cuid())
  callFlowId           String
  ruleTitle            String
  schedule             Json
  promptsAudioUrl      String?
  keyPrompts           Json
  failoverCount        Int      @default(2)
  failoverDelayMinutes Int      @default(2)
  failoverAudioUrl     String?
  hangupAudioUrl       String?
  leaveMessageOnHash   Boolean  @default(true)
  created              DateTime @default(now())
  updated              DateTime @updatedAt
  backDigit            String?
  callFlow             CallFlow @relation(fields: [callFlowId], references: [id], onDelete: Cascade)

  @@index([callFlowId])
  @@map("call_flow_rules")
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  city      String?
  phone     String?
  hours     Json?
  created   DateTime @default(now())
  updated   DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("locations")
}

model CompanyMember {
  id          String              @id @default(cuid())
  userId      String
  companyId   String
  role        CompanyMemberRole
  permissions Json?
  status      CompanyMemberStatus
  joinedAt    DateTime?
  viewroomSchedule          Json?  @map("viewroom_schedule")
  viewroomScheduledMeetings Json?  @map("viewroom_scheduled_meetings")
  viewroomLocation          Json?  @map("viewroom_location")
  created     DateTime            @default(now())
  updated     DateTime            @updatedAt
  profileData Json?
  company     Company             @relation(fields: [companyId], references: [id])
  user        User                @relation(fields: [userId], references: [id])

  @@unique([userId, companyId])
  @@map("company_members")
}

model Contact {
  id                   String                @id @default(cuid())
  companyId            String
  email                String?
  phone                String?
  name                 String?
  address              String?
  landline             String?
  cell                 String?
  smsPermission        Boolean               @default(false)
  pastNames            Json?
  created              DateTime              @default(now())
  updated              DateTime              @updatedAt
  companyName          String?
  contactType          String?               @default("phone")
  notes                String?
  avatarUrl            String?
  accountBalance       Float?
  engagementScore      Int                   @default(0)
  commContainers       CommContainer[]
  communicationLogs    CommunicationLog[]
  communicationThreads CommunicationThread[]
  company              Company               @relation(fields: [companyId], references: [id])
  tasks                Task[]

  @@index([companyId])
  @@map("contacts")
}

model CommunicationLog {
  id                     String                           @id @default(cuid())
  type                   CommunicationType
  direction              CommunicationDirection
  status                 CommunicationStatus
  source                 String?
  destination            String?
  customerId             String?
  companyId              String
  userId                 String?
  summary                String?
  content                String?
  duration               Float?
  metadata               Json?
  created                DateTime                         @default(now())
  updated                DateTime                         @updatedAt
  callTrackingCategoryId String?
  communicationThreadId  String?
  emailClickedAt         DateTime?                        @map("email_clicked_at")
  emailOpenedAt          DateTime?                        @map("email_opened_at")
  assignedMembers        CommunicationLogAssignedMember[]
  callTrackingCategory   CallTrackingCategory?            @relation(fields: [callTrackingCategoryId], references: [id])
  communicationThread    CommunicationThread?             @relation(fields: [communicationThreadId], references: [id])
  company                Company                          @relation(fields: [companyId], references: [id])
  customer               Contact?                         @relation(fields: [customerId], references: [id])
  user                   User?                            @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([userId])
  @@index([callTrackingCategoryId])
  @@index([communicationThreadId])
  @@index([companyId, type, created])
  @@map("communication_logs")
}

model CommunicationThread {
  id            String             @id @default(cuid())
  companyId     String
  contactId     String?
  status        String             @default("open")
  urgency       String?
  summary       String?
  created       DateTime           @default(now())
  updated       DateTime           @updatedAt
  logs          CommunicationLog[]
  company       Company            @relation(fields: [companyId], references: [id])
  contact       Contact?           @relation(fields: [contactId], references: [id])
  notifications Notification[]
  tasks         Task[]

  @@index([companyId])
  @@index([contactId])
  @@map("communication_threads")
}

model CommunicationLogAssignedMember {
  communicationLogId String
  userId             String
  communicationLog   CommunicationLog @relation(fields: [communicationLogId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communicationLogId, userId])
  @@map("_communication_log_assigned_members")
}

model Invite {
  id          String       @id @default(cuid())
  email       String?
  companyId   String?
  invitedById String?
  userId      String?
  role        InviteRole?
  status      InviteStatus
  expiresAt   DateTime?
  acceptedAt  DateTime?
  declinedAt  DateTime?
  created     DateTime     @default(now())
  updated     DateTime     @updatedAt
  metadata    Json?
  company     Company?     @relation(fields: [companyId], references: [id])
  invitedBy   User?        @relation("InvitedBy", fields: [invitedById], references: [id])
  user        User?        @relation("InvitedUser", fields: [userId], references: [id])

  @@index([companyId])
  @@index([email])
  @@map("invites")
}

model Leadbox {
  id          String        @id @default(cuid())
  ownerId     String
  name        String?
  status      LeadboxStatus
  leadboxData Json?
  created     DateTime      @default(now())
  updated     DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("leadboxes")
}

model Leadform {
  id       String   @id @default(cuid())
  ownerId  String
  name     String
  formData Json?
  created  DateTime @default(now())
  updated  DateTime @updatedAt
  owner    User     @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("leadforms")
}

model Logo {
  id      String   @id @default(cuid())
  logo    String?
  created DateTime @default(now())
  updated DateTime @updatedAt

  @@map("logos")
}

model Message {
  id            String          @id @default(cuid())
  threadId      String          @unique
  companyId     String
  customerName  String?
  customerEmail String?
  customerPhone String?
  assignedToId  String?
  status        MessageStatus
  urgency       MessageUrgency?
  aiSummary     String?
  messages      Json?
  created       DateTime        @default(now())
  updated       DateTime        @updatedAt
  draftResponse String?
  intent        String?
  sentiment     String?
  urgencyScore  Int?
  assignedTo    User?           @relation(fields: [assignedToId], references: [id])
  company       Company         @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([assignedToId])
  @@index([status])
  @@map("messages")
}

model CallLog {
  id        String   @id @default(cuid())
  callId    String
  status    String
  to        String?
  from      String?
  duration  Float?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([callId])
  @@index([from])
  @@index([to])
  @@index([callId, status])
  @@map("call_logs")
}

model CallRecording {
  id          String   @id @default(cuid())
  callId      String
  recordingId String?
  urls        Json?
  createdAt   DateTime @default(now())

  @@unique([callId, recordingId])
  @@index([callId])
  @@map("call_recordings")
}

model CallState {
  callId                String    @id
  hasVoicemail          Boolean   @default(false)
  intentDigit           String?
  intentName            String?
  intentConfidence      String?
  intentTimestamp       DateTime?
  voicemailRecordingIds Json?     @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("call_states")
}

model Notification {
  id                    String                 @id @default(cuid())
  companyId             String
  type                  CommunicationType
  direction             CommunicationDirection
  sourceName            String?
  sourceIdentifier      String?
  messagePreview        String
  content               String?
  read                  Boolean                @default(false)
  communicationLogId    String?
  messageId             String?
  threadId              String?
  createdAt             DateTime               @default(now())
  communicationThreadId String?
  communicationThread   CommunicationThread?   @relation(fields: [communicationThreadId], references: [id])
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([read])
  @@index([communicationThreadId])
  @@map("notifications")
}

model ScheduleEvent {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  color       String?
  created     DateTime @default(now())
  updated     DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, startTime])
  @@map("schedule_events")
}

model Shortcut {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  code      String
  message   String
  created   DateTime @default(now())
  updated   DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, userId])
  @@map("shortcuts")
}

model UserDevice {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String
  platform  String?
  fcmToken  String?
  voipToken String?
  created   DateTime @default(now())
  updated   DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model Task {
  id                    String               @id @default(cuid())
  companyId             String
  contactId             String?
  assignedToId          String?
  title                 String
  description           String?
  status                TaskStatus           @default(todo)
  dueDate               DateTime?
  created               DateTime             @default(now())
  updated               DateTime             @updatedAt
  communicationThreadId String?
  assignedTo            User?                @relation("UserTasks", fields: [assignedToId], references: [id])
  communicationThread   CommunicationThread? @relation(fields: [communicationThreadId], references: [id])
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact               Contact?             @relation(fields: [contactId], references: [id])

  @@index([companyId])
  @@index([contactId])
  @@index([assignedToId])
  @@index([communicationThreadId])
  @@map("tasks")
}

model PipelineEvent {
  id                    String                      @id @default(cuid())
  eventId               String                      @unique
  traceId               String?
  provider              String?
  providerEventName     String?
  providerEventId       String?                     @unique
  eventType             String
  networkCategory       String                      @default("Communication")
  companyId             String?
  customerProfileId     String?
  authorName            String?
  reviewRatingNumeric   Int?
  reviewText            String?
  occurredAt            DateTime?                   @default(now())
  receivedAt            DateTime?                   @default(now())
  unstructuredText      String?
  isDuplicate           Boolean                     @default(false)
  requiresAiExtraction  Boolean                     @default(false)
  aiExtractionCompleted Boolean                     @default(false)
  processingStatus      String                      @default("received")
  handoffEligible       Boolean                     @default(false)
  businessReplyExists   Boolean                     @default(false)
  createdAt             DateTime                    @default(now())
  complaintThemeLogs    PipelineComplaintThemeLog[]
  decisions             PipelineDecision[]
  enrichments           PipelineEnrichment[]
  company               Company?                    @relation(fields: [companyId], references: [id])
  customerProfile       PipelineCustomerProfile?    @relation(fields: [customerProfileId], references: [id])
  signals               PipelineSignal[]

  @@index([companyId])
  @@index([customerProfileId])
  @@index([providerEventId])
  @@map("pipeline_events")
}

model PipelineEnrichment {
  id                          String        @id @default(cuid())
  eventId                     String
  aiContainsProblem           Boolean?      @default(false)
  aiContainsQuoteRequest      Boolean?      @default(false)
  aiContainsCallbackRequest   Boolean?      @default(false)
  aiContainsEmergencyKeywords Boolean?      @default(false)
  aiRequestedContactMethod    String?
  aiRequestedAction           String?
  aiDetectedKeywords          Json?         @default("[]")
  aiSentiment                 String?
  aiSentimentScore            Float?
  aiPraiseDetected            Boolean?      @default(false)
  aiComplaintDetected         Boolean?      @default(false)
  aiPraiseTopics              Json?         @default("[]")
  aiComplaintTopics           Json?         @default("[]")
  aiPrimaryPraiseTopic        String?
  aiPrimaryComplaintTopic     String?
  aiServiceMentioned          String?
  aiCustomerExperienceIssue   String?
  aiUrgencyLevel              String?
  aiSummary                   String?
  aiConfidenceScore           Float?
  aiCustomerName              String?
  aiHasName                   Boolean?      @default(false)
  sentiment                   String?
  summary                     String?
  urgencyLevel                String?
  serviceRequested            String?
  confidenceScore             Float?
  createdAt                   DateTime      @default(now())
  aiEmergencyType             String?
  event                       PipelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("pipeline_enrichments")
}

model PipelineSignal {
  id           String         @id @default(cuid())
  eventId      String?
  signalRuleId String?
  name         String
  bucket       String
  priority     Int            @default(2)
  confidence   Float          @default(1.0)
  status       String         @default("candidate")
  createdAt    DateTime       @default(now())
  event        PipelineEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([signalRuleId])
  @@map("pipeline_signals")
}

model PipelineDecision {
  id                       String                @id @default(cuid())
  decisionId               String                @unique
  eventId                  String
  dominantSignalId         String?
  supportingSignalIds      Json                  @default("[]")
  selectedActionIds        Json                  @default("[]")
  blockedActionIds         Json                  @default("[]")
  executionMode            String
  owner                    String
  priority                 Int
  reason                   String?
  businessConfigSnapshot   Json?
  safetyChecksPassed       Boolean               @default(false)
  consultantReviewRequired Boolean               @default(true)
  consultantId             String?
  approvalRoute            String?
  createdAt                DateTime              @default(now())
  actionQueue              PipelineActionQueue[]
  event                    PipelineEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("pipeline_decisions")
}

model PipelineActionQueue {
  id                       String              @id @default(cuid())
  queueTraceId             String?             @unique
  decisionId               String
  actionId                 String
  executionLane            String
  parameters               Json                @default("{}")
  status                   String              @default("pending")
  dueAt                    DateTime?
  consultantId             String?
  consultantReviewRequired Boolean             @default(false)
  approvalRoute            String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  slaEscalatedAt           DateTime?
  decision                 PipelineDecision    @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  executions               PipelineExecution[]

  @@index([decisionId])
  @@map("pipeline_action_queue")
}

model PipelineExecution {
  id                    String                      @id @default(cuid())
  actionExecutionId     String                      @unique
  actionQueueId         String
  actionId              String
  executionMode         String
  executionStatus       String                      @default("created_pending_route")
  generatedOutput       String?
  approvalStatus        String?
  approvalOwner         String?
  requiresHumanApproval Boolean                     @default(false)
  approvedAt            DateTime?
  rejectedAt            DateTime?
  humanEdited           Boolean                     @default(false)
  editedOutput          String?
  postedExternally      Boolean                     @default(false)
  failureReason         String?
  retryCount            Int                         @default(0)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  approvalPackages      PipelineApprovalPackage[]
  complaintLogs         PipelineComplaintThemeLog[]
  actionQueue           PipelineActionQueue         @relation(fields: [actionQueueId], references: [id], onDelete: Cascade)

  @@index([actionQueueId])
  @@map("pipeline_executions")
}

model PipelineApprovalPackage {
  id                String            @id @default(cuid())
  approvalPackageId String            @unique
  executionId       String
  owner             String
  status            String            @default("pending_approval")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  execution         PipelineExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("pipeline_approval_packages")
}

model PipelineOutcome {
  id                  String   @id @default(cuid())
  outcomeId           String   @unique
  eventId             String
  decisionId          String
  actionQueueId       String
  executionId         String
  actionId            String
  outcomeType         String
  outcomeStatus       String
  timeToResponseHours Float?
  approvalWaitHours   Float?
  humanEdited         Boolean  @default(false)
  postedExternally    Boolean  @default(false)
  doNotCountAsSuccess Boolean  @default(false)
  details             Json?
  feedbackId          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("pipeline_outcomes")
}

model PipelineFeedbackRecord {
  id                     String   @id @default(cuid())
  feedbackId             String   @unique
  eventId                String
  decisionId             String
  actionQueueId          String
  executionId            String
  outcomeId              String
  actionId               String
  signalValidity         String?
  decisionQuality        String?
  actionExecutionQuality String?
  outcomeResult          String?
  humanReviewState       String?
  tuningCandidates       Json     @default("[]")
  productionRulesChanged Boolean  @default(false)
  details                Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("pipeline_feedback_records")
}

model PipelineComplaintThemeLog {
