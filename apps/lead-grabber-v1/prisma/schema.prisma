model Cohort2Trajectory {
  id                 String   @id @default(cuid())
  companyId          String
  contactId          String?
  bucketHistory      Json?
  scorePath          Json?
  tierProgression    Json?
  personaBand        String?
  channelSequence    Json?
  bookedJobOutcome   String?
  closedAt           DateTime @default(now())
  /// won | lost — the terminal relationship outcome (Pipeline Reference §10.2 step 3).
  outcomeResult      String?
  /// Required when outcomeResult = 'lost', null when 'won'. Canonical vocabulary — see LossReason.
  lossReason         String?
  /// Anonymized relationship identity. Section 8 writes are "anonymized and PII-redacted" (§1.5),
  /// so the record carries a one-way hash for entry-eligibility (§10.2 step 2) instead of a
  /// contact FK. `contactId` above is retained for legacy rows and is no longer written.
  relationshipKey    String?
  /// The 5 documented trajectory layers (§10.4 / clearsky-layers-reference.md).
  behavioural        Json?
  demographic        Json?
  languageSentiment  Json?
  timeTrend          Json?
  interestAffinity   Json?
  /// Cross-cutting, not a 6th layer. Business-level Stream B join — never individual-attached.
  rankContext        Json?
  /// Transcript with names/phones stripped, sentence structure intact (§10.2 step 11).
  redactedTranscript String?
  /// Realized revenue. 0 for a loss — never the quoted/at-stake value (§10.4).
  closeValue         Int      @default(0)
  touchesToOutcome   Int      @default(0)

  @@index([companyId])
  @@index([companyId, contactId])
  @@index([relationshipKey])
  @@map("cohort2_trajectories")
}

/// A suspected duplicate pair raised by identity resolution (same ANI on two profiles, an
/// extracted email that already belongs to someone else, etc). Never auto-merged — a human
/// resolves each one, and the merge is recorded here with a snapshot so it can be undone.
model ProfileMergeCandidate {
  id                 String    @id @default(cuid())
  companyId          String
  primaryProfileId   String
  duplicateProfileId String
  reason             String
  status             String    @default("pending")
  detectedFromCommId String?
  resolvedByUserId   String?
  resolvedAt         DateTime?
  /// What the duplicate looked like before the merge + which rows moved, for reversal.
  mergeSnapshot      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, primaryProfileId, duplicateProfileId])
  @@index([companyId, status])
  @@map("profile_merge_candidates")
}

/// An identifier that points at a person: an email, a mobile, a landline, a fingerprint, a cookie.
///
/// None of these IS the identity — the profile is. They are keys hanging off it, and a person may
/// have any number of them.
model CommIdentifier {
  id                String                  @id @default(cuid())
  companyId         String
  customerProfileId String
  kind              String
  value             String
  createdAt         DateTime                @default(now())
  customerProfile   PipelineCustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The rule, written where it can't be ignored: within one company an identifier points at
  /// exactly one person. A second profile carrying the same email is not a duplicate we discover
  /// weeks later — it is a write that fails.
  @@unique([companyId, kind, value])
  /// Retained so existing upserts keyed on (profile, kind, value) keep working.
  @@unique([customerProfileId, kind, value])
  @@index([kind, value])
  @@map("comm_identifiers")
}

